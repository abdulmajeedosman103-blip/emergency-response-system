# backend/.env.example
# Copy this file to .env and set your real values. Never commit .env.
# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/emergency_db?schema=public"

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# JWT — replace JWT_SECRET with a long random string (e.g. openssl rand -hex 48)
JWT_SECRET="please-replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# SOS duplicate-protection cooldown between successive alerts per user (seconds)
SOS_COOLDOWN_SECONDS=60